## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Visual Studio cache / temp files
.vs/
*.vscode/
*.code-workspace

# User-specific files
*.user
*.suo
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/

# Visual Studio 2015/2017 cache/options directory
.vs/

# Visual Studio Trace Files
*.svclog
*.scc

# Visual Studio profiler
*.psess
*.vsp
*.vspx

# Resharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# Rider
.idea/
*.sln.iml

# DotCover
*.dcvr
*.dcvr_surge

# NuGet
*.nupkg
# NuGet packages folder
packages/
# except build/, which is used as an MSBuild target.
!packages/build/

# CMake
[Cc]MakeFiles/
[Cc]MakeCache.txt
[Cc]MakeScripts/
CTestTestfile.cmake
cmake_install.cmake
*.[Cc]MakeLists.txt.user*
out/

# Node modules (si usas front-end con .NET)
node_modules/

# Compiled files
*.dll
*.exe
*.pdb
*.cache
*.so
*.dylib
*.lib

# Publish output
publish/
app.publish/

# Azure
*.pubxml
*.pubxml.user

# Others
*.tmp
*.temp
*.log
*.vsidx

# Prevent chec
